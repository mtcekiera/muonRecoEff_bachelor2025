# !/bin/bash
source ~/root/bin/thisroot.sh
# set -euo pipefail

if [ $# -eq 0 ]; then
  echo "Usage: $0 [-m] [-d] [-g] [-p] [-e] [-c] [-h]"
  echo "  -m    Analyse mc_sc data"
  echo "  -d    Analyse real data"
  echo "  -g    Generate histograms"
  echo "  -p    Plot histograms"
  echo "  -e    Make efficiency plots"
  echo "  -c    Plot cutflows"
  echo "  -h    Show this help message"
  exit 1
fi

while getopts "mdgpwefsbzh" opt; do
  case $opt in
    m)
        echo "Looping mc_sc data"
        
        for x in {1..5}; do
            echo "(MC, SuperChic) Analysing wp=$x"
            root -l -q "G2TauTree.C(\"./input/mc_sc_4m7.root\", \"./output/ID_MS/w${x}/mc_sc_4m7.root\", 0, 925, $x)"
            root -l -q "G2TauTree.C(\"./input/mc_sc_4m7.root\", \"./output/mu_ID/w${x}/mc_sc_4m7.root\", 1, 925, $x)"

            root -l -q "G2TauTree.C(\"./input/mc_sc_7m20.root\", \"./output/ID_MS/w${x}/mc_sc_7m20.root\", 0, 265, $x)"
            root -l -q "G2TauTree.C(\"./input/mc_sc_7m20.root\", \"./output/mu_ID/w${x}/mc_sc_7m20.root\", 1, 265, $x)"

            root -l -q "G2TauTree.C(\"./input/mc_sc_20m.root\", \"./output/ID_MS/w${x}/mc_sc_20m.root\", 0, 9.74, $x)"
            root -l -q "G2TauTree.C(\"./input/mc_sc_20m.root\", \"./output/mu_ID/w${x}/mc_sc_20m.root\", 1, 9.74, $x)"

            echo "Merging files"
            hadd -f -v 0 ./output/ID_MS/w"${x}"/mc_sc.root ./output/ID_MS/w"${x}"/mc_sc_4m7.root ./output/ID_MS/w"${x}"/mc_sc_7m20.root ./output/ID_MS/w"${x}"/mc_sc_20m.root
            hadd -f -v 0 ./output/mu_ID/w"${x}"/mc_sc.root ./output/mu_ID/w"${x}"/mc_sc_4m7.root ./output/mu_ID/w"${x}"/mc_sc_7m20.root ./output/mu_ID/w"${x}"/mc_sc_20m.root
        done

        for x in {1..5}; do
            echo "(MC, StarLight) Analysing wp=$x"
            root -l -q "G2TauTree.C(\"./input/mc_sl_4m7.root\", \"./output/ID_MS/w${x}/mc_sl_4m7.root\", 0, 741, $x)"
            root -l -q "G2TauTree.C(\"./input/mc_sl_4m7.root\", \"./output/mu_ID/w${x}/mc_sl_4m7.root\", 1, 741, $x)"

            root -l -q "G2TauTree.C(\"./input/mc_sl_7m20.root\", \"./output/ID_MS/w${x}/mc_sl_7m20.root\", 0, 207, $x)"
            root -l -q "G2TauTree.C(\"./input/mc_sl_7m20.root\", \"./output/mu_ID/w${x}/mc_sl_7m20.root\", 1, 207, $x)"

            root -l -q "G2TauTree.C(\"./input/mc_sl_20m.root\", \"./output/ID_MS/w${x}/mc_sl_20m.root\", 0, 7.14, $x)"
            root -l -q "G2TauTree.C(\"./input/mc_sl_20m.root\", \"./output/mu_ID/w${x}/mc_sl_20m.root\", 1, 7.14, $x)"

            echo "Merging files"
            hadd -f -v 0 ./output/ID_MS/w"${x}"/mc_sl.root ./output/ID_MS/w"${x}"/mc_sl_4m7.root ./output/ID_MS/w"${x}"/mc_sl_7m20.root ./output/ID_MS/w"${x}"/mc_sl_20m.root
            hadd -f -v 0 ./output/mu_ID/w"${x}"/mc_sl.root ./output/mu_ID/w"${x}"/mc_sl_4m7.root ./output/mu_ID/w"${x}"/mc_sl_7m20.root ./output/mu_ID/w"${x}"/mc_sl_20m.root
        done

        for x in {1..5}; do
            echo "(MC, MadGraph) Analysing wp=$x"
            root -l -q "G2TauTree.C(\"./input/mc_mg_4m7.root\", \"./output/ID_MS/w${x}/mc_mg_4m7.root\", 0, 921, $x)"
            root -l -q "G2TauTree.C(\"./input/mc_mg_4m7.root\", \"./output/mu_ID/w${x}/mc_mg_4m7.root\", 1, 921, $x)"

            root -l -q "G2TauTree.C(\"./input/mc_mg_7m20.root\", \"./output/ID_MS/w${x}/mc_mg_7m20.root\", 0, 264, $x)"
            root -l -q "G2TauTree.C(\"./input/mc_mg_7m20.root\", \"./output/mu_ID/w${x}/mc_mg_7m20.root\", 1, 264, $x)"

            root -l -q "G2TauTree.C(\"./input/mc_mg_20m.root\", \"./output/ID_MS/w${x}/mc_mg_20m.root\", 0, 9.54, $x)"
            root -l -q "G2TauTree.C(\"./input/mc_mg_20m.root\", \"./output/mu_ID/w${x}/mc_mg_20m.root\", 1, 9.54, $x)"

            echo "Merging files"
            hadd -f -v 0 ./output/ID_MS/w"${x}"/mc_mg.root ./output/ID_MS/w"${x}"/mc_mg_4m7.root ./output/ID_MS/w"${x}"/mc_mg_7m20.root ./output/ID_MS/w"${x}"/mc_mg_20m.root
            hadd -f -v 0 ./output/mu_ID/w"${x}"/mc_mg.root ./output/mu_ID/w"${x}"/mc_mg_4m7.root ./output/mu_ID/w"${x}"/mc_mg_7m20.root ./output/mu_ID/w"${x}"/mc_mg_20m.root
        done
        ;;
    d)
        echo "Generating data histograms"
        for x in {0..5}; do
            echo "(Data) Analysing wp=$x"
            root -l -q "G2TauTree.C(\"./input/data23.root\", \"./output/ID_MS/w${x}/data23.root\", 0, 0.0, $x)"
            root -l -q "G2TauTree.C(\"./input/data23.root\", \"./output/mu_ID/w${x}/data23.root\", 1, 0.0, $x)"
        done
        ;;
    g)
        echo "Generating histograms"
        for x in {1..5}; do

            python3 genHistograms.py ./output/ID_MS/w"${x}"/mc_sc.root ./output/ID_MS/w"${x}"/hist_mc_sc.root "${x}"
            python3 genHistograms.py ./output/mu_ID/w"${x}"/mc_sc.root ./output/mu_ID/w"${x}"/hist_mc_sc.root "${x}"
            
            python3 genHistograms.py ./output/ID_MS/w"${x}"/mc_sl.root ./output/ID_MS/w"${x}"/hist_mc_sl.root "${x}"
            python3 genHistograms.py ./output/mu_ID/w"${x}"/mc_sl.root ./output/mu_ID/w"${x}"/hist_mc_sl.root "${x}"

            python3 genHistograms.py ./output/ID_MS/w"${x}"/mc_mg.root ./output/ID_MS/w"${x}"/hist_mc_mg.root "${x}"
            python3 genHistograms.py ./output/mu_ID/w"${x}"/mc_mg.root ./output/mu_ID/w"${x}"/hist_mc_mg.root "${x}"

        done

        # for x in {0..5}; do
        #     python3 genHistograms.py ./output/ID_MS/w"${x}"/data23.root ./output/ID_MS/w"${x}"/hist_data23.root "${x}"
        #     python3 genHistograms.py ./output/mu_ID/w"${x}"/data23.root ./output/mu_ID/w"${x}"/hist_data23.root "${x}"
        # done
        ;;
    p)
        echo "Plotting histograms for nominal cuts"
        python3 plotHistograms.py ./output/ID_MS/w0/hist_data23.root ./output/ID_MS/w0/hist_mc_sc.root ./histograms/variables_nominal/ID_MS_sc.pdf
        python3 plotHistograms.py ./output/mu_ID/w0/hist_data23.root ./output/mu_ID/w0/hist_mc_sc.root ./histograms/variables_nominal/mu_ID_sc.pdf
        python3 plotHistograms.py ./output/ID_MS/w0/hist_data23.root ./output/ID_MS/w0/hist_mc_sl.root ./histograms/variables_nominal/ID_MS_sl.pdf
        python3 plotHistograms.py ./output/mu_ID/w0/hist_data23.root ./output/mu_ID/w0/hist_mc_sl.root ./histograms/variables_nominal/mu_ID_sl.pdf
        python3 plotHistograms.py ./output/ID_MS/w0/hist_data23.root ./output/ID_MS/w0/hist_mc_mg.root ./histograms/variables_nominal/ID_MS_mg.pdf
        python3 plotHistograms.py ./output/mu_ID/w0/hist_data23.root ./output/mu_ID/w0/hist_mc_mg.root ./histograms/variables_nominal/mu_ID_mg.pdf
        
        ;;
    # w)
    #     echo "Plotting working point histograms"
    #     python3 plotHistoWP.py ID_MS hist_data23.root ./histograms/wp_variables/ID_MS_data.pdf data
    #     python3 plotHistoWP.py mu_ID hist_data23.root ./histograms/wp_variables/mu_ID_data.pdf data

    #     python3 plotHistoWP.py ID_MS hist_mc_sc.root ./histograms/wp_variables/ID_MS_mc_sc.pdf mc
    #     python3 plotHistoWP.py mu_ID hist_mc_sc.root ./histograms/wp_variables/mu_ID_mc_sc.pdf mc

    #     python3 plotHistoWP.py ID_MS hist_mc_sl.root ./histograms/wp_variables/ID_MS_mc_sl.pdf mc
    #     python3 plotHistoWP.py mu_ID hist_mc_sl.root ./histograms/wp_variables/mu_ID_mc_sl.pdf mc

    #     python3 plotHistoWP.py ID_MS hist_mc_mg.root ./histograms/wp_variables/ID_MS_mc_mg.pdf mc
    #     python3 plotHistoWP.py mu_ID hist_mc_mg.root ./histograms/wp_variables/mu_ID_mc_mg.pdf mc

    # ;;
    e)
        echo "Generating efficiency files"
        for x in {0..5}; do
            python3 genEff.py w"${x}"/hist_data23.root ./output/eff/w"${x}"/eff_data23.root
            python3 genEff.py w"${x}"/hist_mc_sc.root ./output/eff/w"${x}"/eff_mc_sc.root
            python3 genEff.py w"${x}"/hist_mc_sl.root ./output/eff/w"${x}"/eff_mc_sl.root
            python3 genEff.py w"${x}"/hist_mc_mg.root ./output/eff/w"${x}"/eff_mc_mg.root
        done

        # echo "Calculating scale factors"
        # for x in {0..5}; do
        #     python3 genSF.py ./output/eff/w"${x}"/eff_data23.root ./output/eff/w"${x}"/eff_mc_sc.root ./output/eff/w"${x}"/sf_sc.root
        #     python3 genSF.py ./output/eff/w"${x}"/eff_data23.root ./output/eff/w"${x}"/eff_mc_sl.root ./output/eff/w"${x}"/sf_sl.root
        #     python3 genSF.py ./output/eff/w"${x}"/eff_data23.root ./output/eff/w"${x}"/eff_mc_mg.root ./output/eff/w"${x}"/sf_mg.root
        # done
        ;;
    f)
        echo "Plotting nominal efficiencies"
        python3 plotEff.py ./output/eff/w0/eff_data23.root ./output/eff/w0/eff_mc_sc.root ./histograms/efficiencies/w0_sc.pdf
        python3 plotEff.py ./output/eff/w0/eff_data23.root ./output/eff/w0/eff_mc_sl.root ./histograms/efficiencies/w0_sl.pdf
        python3 plotEff.py ./output/eff/w0/eff_data23.root ./output/eff/w0/eff_mc_mg.root ./histograms/efficiencies/w0_mg.pdf
        ;;
    s)
        echo "Calculating scale factors"
        for x in {0..5}; do
            python3 genSF.py ./output/eff/w"${x}"/eff_data23.root ./output/eff/w"${x}"/eff_mc_sc.root ./output/eff/w"${x}"/sf_sc.root
            python3 genSF.py ./output/eff/w"${x}"/eff_data23.root ./output/eff/w"${x}"/eff_mc_sl.root ./output/eff/w"${x}"/sf_sl.root
            python3 genSF.py ./output/eff/w"${x}"/eff_data23.root ./output/eff/w"${x}"/eff_mc_mg.root ./output/eff/w"${x}"/sf_mg.root
        done
    ;;
    z)
        echo "Plotting scale factors with systematic errors"
        python3 plotSFsyst.py sf_sc.root ./histograms/scale_factors/sc_pt.pdf scale_factor_pT
        python3 plotSFsyst.py sf_sl.root ./histograms/scale_factors/sl_pt.pdf scale_factor_pT 
        python3 plotSFsyst.py sf_mg.root ./histograms/scale_factors/mg_pt.pdf scale_factor_pT 

        python3 plotSFsyst.py sf_sc.root ./histograms/scale_factors/sc_qeta.pdf scale_factor_qEta
        python3 plotSFsyst.py sf_sl.root ./histograms/scale_factors/sl_qeta.pdf scale_factor_qEta
        python3 plotSFsyst.py sf_mg.root ./histograms/scale_factors/mg_qeta.pdf scale_factor_qEta

    ;;
    h)
        echo "Usage: $0 [-m] [-d] [-h] [-b]"
        echo "  -m    Analyse mc_sc data"
        echo "  -d    Analyse real data"  
        echo "  -b    Open TBrowser"
        echo "  -h    Show this help message"   
        exit 1
        ;;
    \?)
      echo "Invalid option: -$OPTARG"
      ;;
  esac
done
echo "Done!"